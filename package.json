{
  "name": "ci-workflows",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ci-tools": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "verify:pack": "node scripts/verifyPackedCli.ts",
    "verify:repair": "node scripts/verifyRealRepair.ts",
    "check-lockfile": "node scripts/check-lockfile.ts",
    "repair-lockfile": "node scripts/repair-lockfile.ts",
    "release": "node scripts/release/cli.ts"
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
