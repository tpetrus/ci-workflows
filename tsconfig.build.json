{
  "extends": "./tsconfig.json",
  // Emits the JavaScript that the published `ci-tools` bin runs. The sources are run directly as .ts everywhere
  // inside this repo (composite actions, npm scripts, vitest), but Node refuses to strip types from .ts files under
  // node_modules, which is where npx installs this package, so the bin has to be plain JavaScript.
  "include": ["scripts/**/*"],
  // Specs, their support code and fixtures, and the verify scripts are repo-internal; none of them belongs in the
  // published package.
  "exclude": ["node_modules", "scripts/**/*.test.ts", "scripts/testSupport", "scripts/fixtures", "scripts/verifyPackedCli.ts", "scripts/verifyRealRepair.ts"],
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "scripts",
    // The sources import siblings as './x.ts' (what Node needs when it runs them directly); this rewrites those to
    // './x.js' in the emitted files, which is what Node needs when it runs the output.
    "rewriteRelativeImportExtensions": true
  }
}
